# Application
RESEARCHFLOW_ENVIRONMENT=development
RESEARCHFLOW_SIMULATION_STEP_DELAY=0.7

# Database
RESEARCHFLOW_DATABASE_URL=sqlite+aiosqlite:///./var/researchflow.db

# Web application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Workflow: simulation（离线演示）、llm（仅真实规划）或 langgraph（M2 网页研究）
RESEARCHFLOW_WORKFLOW_MODE=simulation

# LLM（workflow mode=llm 或 langgraph 时使用）
RESEARCHFLOW_LLM_PROVIDER=openai-compatible
RESEARCHFLOW_LLM_MODEL=
RESEARCHFLOW_LLM_API_KEY=
# 填 API 根地址；客户端会自动追加 /chat/completions。
RESEARCHFLOW_LLM_BASE_URL=https://api.openai.com/v1
RESEARCHFLOW_LLM_TIMEOUT_SECONDS=60

# M2 通用网页研究（langgraph 模式需要 Exa API Key）
RESEARCHFLOW_WEB_SEARCH_PROVIDER=exa
RESEARCHFLOW_WEB_SEARCH_BASE_URL=https://api.exa.ai
RESEARCHFLOW_WEB_SEARCH_API_KEY=
RESEARCHFLOW_WEB_SEARCH_RESULT_LIMIT=3
RESEARCHFLOW_WEB_CONTENT_MAX_CHARACTERS=16000
RESEARCHFLOW_WEB_REQUEST_TIMEOUT_SECONDS=20
RESEARCHFLOW_WEB_USER_AGENT=ResearchFlow/0.1 (portfolio research demo)
