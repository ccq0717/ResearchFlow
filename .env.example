# Application
RESEARCHFLOW_ENVIRONMENT=development
RESEARCHFLOW_SIMULATION_STEP_DELAY=0.7

# Database
RESEARCHFLOW_DATABASE_URL=sqlite+aiosqlite:///./var/researchflow.db

# Web application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# JSON 数组；本地开发同时允许 localhost 与 127.0.0.1 前端地址。
RESEARCHFLOW_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Workflow: simulation（离线演示）、llm（仅真实规划）或 langgraph（M4 网页 + 本地知识研究）
RESEARCHFLOW_WORKFLOW_MODE=simulation

# LLM（workflow mode=llm 或 langgraph 时使用）
RESEARCHFLOW_LLM_PROVIDER=openai-compatible
RESEARCHFLOW_LLM_MODEL=
RESEARCHFLOW_LLM_API_KEY=
# 填 API 根地址；客户端会自动追加 /chat/completions。
RESEARCHFLOW_LLM_BASE_URL=https://api.openai.com/v1
RESEARCHFLOW_LLM_TIMEOUT_SECONDS=180

# M2/M3 通用网页研究与来源质量评测（langgraph 模式需要 Exa API Key）
RESEARCHFLOW_WEB_SEARCH_PROVIDER=exa
RESEARCHFLOW_WEB_SEARCH_BASE_URL=https://api.exa.ai
RESEARCHFLOW_WEB_SEARCH_API_KEY=
RESEARCHFLOW_WEB_SEARCH_RESULT_LIMIT=3
RESEARCHFLOW_WEB_CONTENT_MAX_CHARACTERS=16000
RESEARCHFLOW_WEB_REQUEST_TIMEOUT_SECONDS=20
RESEARCHFLOW_WEB_USER_AGENT=ResearchFlow/0.1 (portfolio research demo)

# M4 本地知识库（所有模式都可上传管理；langgraph 模式可在研究中使用）
RESEARCHFLOW_KNOWLEDGE_UPLOAD_DIRECTORY=./var/uploads
RESEARCHFLOW_KNOWLEDGE_MAX_DOCUMENT_BYTES=10485760
RESEARCHFLOW_KNOWLEDGE_MAX_DOCUMENT_COUNT=50
RESEARCHFLOW_KNOWLEDGE_MAX_SELECTION_COUNT=10
RESEARCHFLOW_KNOWLEDGE_CHUNK_SIZE=1200
RESEARCHFLOW_KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
RESEARCHFLOW_KNOWLEDGE_MAX_PDF_PAGES=200
RESEARCHFLOW_KNOWLEDGE_MAX_PDF_PAGE_STREAM_BYTES=5242880
# lexical、vector（字符 n-gram 稀疏向量）或 hybrid；固定小样当前推荐 lexical。
RESEARCHFLOW_KNOWLEDGE_RETRIEVAL_MODE=lexical
RESEARCHFLOW_KNOWLEDGE_RESULTS_PER_QUESTION=2
