# Application
RESEARCHFLOW_ENVIRONMENT=development
RESEARCHFLOW_LOG_LEVEL=INFO
RESEARCHFLOW_DATA_DIR=./var
RESEARCHFLOW_SIMULATION_STEP_DELAY=0.7

# Database
RESEARCHFLOW_DATABASE_URL=sqlite+aiosqlite:///./var/researchflow.db

# Web application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM provider (leave secrets empty in committed files)
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Search provider
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
