# Workflow: simulation（离线演示）、llm（仅真实规划）或 langgraph（网页 + 本地知识研究）
RESEARCHFLOW_WORKFLOW_MODE=simulation

# LLM（workflow mode=llm 或 langgraph 时使用）
RESEARCHFLOW_LLM_MODEL=
RESEARCHFLOW_LLM_API_KEY=
# 填 API 根地址；客户端会自动追加 /chat/completions。
RESEARCHFLOW_LLM_BASE_URL=https://api.openai.com/v1
RESEARCHFLOW_LLM_TIMEOUT_SECONDS=180
# 可选：供应商公布的每百万 Token 美元单价，用于运行页估算 LLM 费用。
# RESEARCHFLOW_LLM_INPUT_COST_PER_MILLION_TOKENS=
# RESEARCHFLOW_LLM_OUTPUT_COST_PER_MILLION_TOKENS=

# 通用网页搜索（langgraph 模式需要 Exa API Key）
RESEARCHFLOW_WEB_SEARCH_API_KEY=

# Embedding（上传/重新处理知识文档及 langgraph 本地检索时使用）
# 当前推荐 Gemini 原生接口；也可选择 openai-compatible 适配器。
RESEARCHFLOW_EMBEDDING_PROVIDER=gemini
# 填供应商支持的模型名，例如 gemini-embedding-2；更换模型后需重新处理已有文档。
RESEARCHFLOW_EMBEDDING_MODEL=
RESEARCHFLOW_EMBEDDING_API_KEY=
# 可选：Gemini Embedding 2 使用 768 维以降低 SQLite 存储量；其他模型不支持时删除此行。
RESEARCHFLOW_EMBEDDING_DIMENSIONS=768
